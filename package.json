{
    "name": "mauzer",
    "productName": "Mauzer",
    "version": "1.1.14",
    "description": "Mauzer — Fast, Dark, Minimal Web Browser",
    "repository": {
        "type": "git",
        "url": "https://github.com/xx0loxi/update-mauzer.git"
    },
    "main": "main.js",
    "scripts": {
        "start": "chcp 65001 >nul && cmd /c \"(set ELECTRON_RUN_AS_NODE=) & electron .\"",
        "dev": "chcp 65001 >nul && cmd /c \"(set ELECTRON_RUN_AS_NODE=) & electron . --dev\"",
        "update-filters": "node scripts/update-filters.js",
        "prebuild": "npm run update-filters",
        "test:ui": "node scripts/test-ui.js",
        "build": "electron-builder --win",
        "release": "electron-builder --win --publish always"
    },
    "build": {
        "appId": "com.mauzer.browser",
        "productName": "Mauzer",
        "directories": {
            "output": "dist"
        },
        "publish": [
            {
                "provider": "github",
                "owner": "xx0loxi",
                "repo": "update-mauzer"
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64",
                        "ia32"
                    ]
                }
            ],
            "icon": "icon_black.png"
        },
        "files": [
            "main.js",
            "preload.js",
            "src/**/*",
            "MAUZER LOGO/**/*",
            "MAUZER PREVIEW.mp4",
            "icon_black.png",
            "node_modules/**/*"
        ],
        "extraResources": [],
        "asar": true
    },
    "author": "mono yt developer",
    "license": "MIT",
    "devDependencies": {
        "electron": "22.3.27",
        "electron-builder": "^25.1.8"
    },
    "dependencies": {
        "better-sqlite3": "^8.2.0",
        "electron-updater": "^6.8.3",
        "msedge-tts": "^2.0.4",
        "sqlite3": "^5.1.4",
        "ws": "^8.19.0"
    }
}
